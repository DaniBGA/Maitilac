# Copiar a .env y ajustar. En desarrollo, la base es la de infra/docker-compose.dev.yml.
DATABASE_URL=postgres://maitilac:maitilac@localhost:5440/maitilac
# Login del gestor. Generar el secreto con: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Usuario de prueba del gestor, sólo desarrollo y tests (se crea con pnpm gestor:usuario)
GESTOR_PRUEBA_EMAIL=prueba@maitilac.local
GESTOR_PRUEBA_CLAVE=
# Carpeta donde se guardan las fotos subidas desde el gestor (en el VPS, un volumen).
FOTOS_DIR=./subidas
