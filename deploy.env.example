# Configuración de scripts/deploy.sh. Copiar a deploy.env (no se sube al repo) y completar.

# Usuario y dirección del VPS (el usuario sin privilegios de root de la guía).
VPS=deploy@203.0.113.10

# Dirección pública del sitio. Para la revisión del cliente: https://nuevo.<dominio>.
SITIO_URL=https://nuevo.ejemplo.com

# Opcionales:
# Carpeta del sitio en el VPS.
#DIR_REMOTO=/srv/maitilac
# Opciones extra de ssh y scp (por ejemplo otro puerto o una clave específica).
# Para el puerto, usar -o Port=XXXX (sirve para los dos comandos).
#SSH_OPCIONES="-o Port=22 -i ~/.ssh/id_ed25519"
