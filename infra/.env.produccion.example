# .env del VPS (/srv/maitilac/.env, permisos 600). Ver docs/OPERACION.md.
# Dominio que atiende Caddy (sin https://). Para la revisión del cliente: nuevo.<dominio>.
DOMINIO=nuevo.ejemplo.com
# La misma dirección, completa.
SITIO_URL=https://nuevo.ejemplo.com
BETTER_AUTH_URL=https://nuevo.ejemplo.com
# Secretos: generarlos con  openssl rand -hex 32
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=
# Imagen del sitio (la publica el deploy automático en GitHub).
IMAGEN=ghcr.io/<usuario>/maitilac:latest
