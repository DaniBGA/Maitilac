# .env del VPS (/srv/maitilac/.env, permisos 600). Lo crea scripts/deploy.sh primera-vez. ¡No borrarlo!
# Dominio que atiende Caddy (sin https://). Para la revisión del cliente: nuevo.<dominio>.
DOMINIO=nuevo.ejemplo.com
# La misma dirección, completa.
SITIO_URL=https://nuevo.ejemplo.com
BETTER_AUTH_URL=https://nuevo.ejemplo.com
# Secretos: los genera scripts/deploy.sh primera-vez (o a mano: openssl rand -hex 32).
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=
# Versión del sitio que está corriendo. La escribe scripts/deploy.sh en cada publicación.
IMAGEN=
