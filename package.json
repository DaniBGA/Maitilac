{
  "name": "maitilac",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "ref:servir": "serve referencia -l 4500 --no-clipboard",
    "ref:capturar": "REFERENCIA=1 playwright test --update-snapshots=all",
    "test:visual": "playwright test",
    "datos:extraer": "tsx scripts/extraer-datos.ts",
    "db:levantar": "docker compose -f infra/docker-compose.dev.yml up -d",
    "db:generar": "drizzle-kit generate",
    "db:migrar": "drizzle-kit migrate",
    "db:importar": "tsx --env-file=.env db/importar/index.ts",
    "db:estudio": "drizzle-kit studio",
    "gestor:usuario": "tsx --env-file=.env scripts/crear-usuario.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.6.0"
}
